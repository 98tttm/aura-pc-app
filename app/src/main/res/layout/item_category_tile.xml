<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryTileRoot"
    android:layout_width="0dp"
    android:layout_height="126dp"
    android:layout_margin="5dp"
    android:layout_columnWeight="1"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/aura_white"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/aura_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/categoryTileIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_category_icon_soft"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_grid"
            app:tint="@color/aura_orange" />

        <TextView
            android:id="@+id/categoryTileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="@string/category_pc_gaming"
            android:textColor="@color/aura_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/categoryTileCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/category_count_42"
            android:textColor="@color/aura_muted"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
