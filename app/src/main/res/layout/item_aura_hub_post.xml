<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#ECECEC" />

    <LinearLayout
        android:id="@+id/hub_post_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="45dp">

                <TextView
                    android:id="@+id/hub_post_avatar_initial"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_hub_avatar_circle"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="#0B0B0B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/hub_post_avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_hub_avatar_circle"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_figma_nav_user" />

                <TextView
                    android:id="@+id/hub_post_follow_plus"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_hub_follow_plus"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/aura_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <View
                android:id="@+id/hub_post_thread_line"
                android:layout_width="1.5dp"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:background="#D7D7D7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hub_post_author"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hub_post_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#777777"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/hub_post_more"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hub_more"
                    android:padding="6dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="#777777" />
            </LinearLayout>

            <TextView
                android:id="@+id/hub_post_topic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#4B44D4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hub_post_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#111111"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/hub_post_image"
                android:layout_width="wrap_content"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:layout_gravity="center_horizontal"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_hub_media"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- Multi-image: horizontal 4:5 carousel (ViewPager2). Adapter populates
                 ViewPager2 + dot strip + counter overlay inside this FrameLayout.
                 Tap → opens AuraHubImageViewerActivity at currently-swiped index. -->
            <FrameLayout
                android:id="@+id/hub_post_images_stack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/hub_post_like"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hub_like"
                    android:padding="5dp"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="#111111" />

                <ImageButton
                    android:id="@+id/hub_post_comment"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="7dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hub_comment"
                    android:padding="5dp"
                    android:src="@drawable/ic_hub_comment"
                    app:tint="#111111" />

                <ImageButton
                    android:id="@+id/hub_post_repost"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="7dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hub_repost"
                    android:padding="5dp"
                    android:src="@drawable/ic_hub_repost"
                    app:tint="#111111" />

                <ImageButton
                    android:id="@+id/hub_post_share"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="7dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hub_share"
                    android:padding="5dp"
                    android:src="@drawable/ic_hub_send"
                    app:tint="#111111" />
            </LinearLayout>

            <TextView
                android:id="@+id/hub_post_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#777777"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
