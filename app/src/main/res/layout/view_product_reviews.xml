<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reviewsContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="@string/review_section_title"
        android:textColor="@color/black"
        android:textSize="22sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/orange_light"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/reviewOverallRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/review_zero_rating"
                android:textColor="@color/black"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <RatingBar
                    android:id="@+id/reviewOverallStars"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="@color/star_yellow"
                    android:stepSize="0.1" />

                <TextView
                    android:id="@+id/reviewOverallCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/review_zero_count"
                    android:textColor="@color/text_gray_label"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/reviewEligibilityMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_spec_card"
        android:padding="12dp"
        android:textColor="@color/orange_dark"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/reviewEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_spec_card"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/review_empty"
        android:textColor="@color/text_gray_label"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reviewsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:nestedScrollingEnabled="false"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewAllReviews"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:text="@string/review_view_all"
        android:textAllCaps="false"
        android:textColor="@color/orange_primary"
        app:cornerRadius="26dp"
        app:strokeColor="@color/orange_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWriteReview"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-bold"
        android:text="@string/review_write_button"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/orange_primary"
        app:cornerRadius="26dp" />
</LinearLayout>
