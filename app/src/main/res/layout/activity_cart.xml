<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_white"
    tools:context=".ui.cart.CartActivity">

    <LinearLayout
        android:id="@+id/cartHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/aura_orange"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/cartLogo"
            android:layout_width="58dp"
            android:layout_height="56dp"
            android:contentDescription="@string/cd_aurapc_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/figma_cart_logo" />

        <TextView
            android:id="@+id/logoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textColor="@color/aura_white"
            android:textSize="20sp" />

        <FrameLayout
            android:id="@+id/cartHeaderNotifications"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/cd_notifications"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_figma_bell_bold" />

            <TextView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_home_badge_red"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/home_badge_count"
                android:textColor="@color/aura_white"
                android:textSize="6sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cartContainer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/home_open_cart"
            android:focusable="true">

            <ImageView
                android:id="@+id/cartIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_figma_cart_large_bold" />

            <TextView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_home_badge_red"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/home_badge_count"
                android:textColor="@color/aura_white"
                android:textSize="6sp" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cartScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/checkoutBar"
        app:layout_constraintTop_toBottomOf="@id/cartHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/cartBackButton"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_figma_cart_back" />

            <TextView
                android:id="@+id/cartTitleText"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/cart_title"
                android:textColor="#FF0B1C30"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCartItemCount"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/cart_item_count_short_default"
                android:textColor="#FF45464D"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCartItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_cart_product" />

            <LinearLayout
                android:id="@+id/promoCodeRow"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="0dp"
                android:gravity="top"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/cartCouponInput"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cart_coupon_input_figma"
                    android:hint="@string/cart_coupon_hint"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="#FF0B1C30"
                    android:textColorHint="#FF45464D"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/cartApplyCoupon"
                    android:layout_width="80dp"
                    android:layout_height="43dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_cart_apply_button_figma"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/cart_apply"
                    android:textColor="@color/aura_white"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderSummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_cart_summary_figma"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:text="@string/cart_summary_title"
                        android:textColor="#FF0B1C30"
                        android:textSize="16sp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:gravity="center_vertical"
                            android:text="@string/cart_subtotal"
                            android:textColor="#FF45464D"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvCartSubtotalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:gravity="center_vertical"
                            android:text="@string/cart_subtotal_price"
                            android:textColor="#FF0B1C30"
                            android:textSize="16sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:gravity="center_vertical"
                            android:text="@string/cart_shipping"
                            android:textColor="#FF45464D"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:gravity="center_vertical"
                            android:text="@string/cart_shipping_free"
                            android:textColor="#FF0B1C30"
                            android:textSize="16sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:gravity="center_vertical"
                            android:text="@string/cart_discount"
                            android:textColor="#FF45464D"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:gravity="center_vertical"
                            android:text="@string/cart_discount_price"
                            android:textColor="#FF0B1C30"
                            android:textSize="16sp" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#4DC6C6CD" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:gravity="center_vertical"
                            android:text="@string/cart_total"
                            android:textColor="#FF0B1C30"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvCartTotalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center_vertical"
                            android:text="@string/cart_dummy_total_price"
                            android:textColor="#FFFD761A"
                            android:textSize="16sp" />
                    </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/checkoutBar"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:background="@drawable/bg_cart_checkout_bar"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="1dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <CheckBox
            android:id="@+id/cbSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="43dp"
            android:buttonTint="@color/aura_black"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/cart_select_all"
            android:textColor="@color/aura_black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnCheckout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_cart_checkout_button_figma"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="@string/cart_checkout"
            android:textColor="@color/aura_white"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
