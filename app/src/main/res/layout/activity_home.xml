<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_white"
    tools:context=".ui.home.HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/aura_orange"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/topMenuButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_aurapc_logo"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/figma_home_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="@color/aura_white"
                android:textSize="20sp" />

            <FrameLayout
                android:id="@+id/topNotificationsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_notifications"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_figma_bell_bold"
                    app:tint="@color/aura_white" />

                <TextView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_home_badge_red"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/home_badge_count"
                    android:textColor="@color/aura_white"
                    android:textSize="6sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/topCartButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/home_open_cart"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_figma_cart_large_bold"
                    app:tint="@color/aura_white" />

                <TextView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_home_badge_red"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/home_badge_count"
                    android:textColor="@color/aura_white"
                    android:textSize="6sp" />
            </FrameLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="112dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="21dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_search_pill"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="17dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search_muted" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/home_figma_search_hint"
                        android:includeFontPadding="false"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="@color/aura_ink"
                        android:textColorHint="#FF6B7280"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/searchFilterButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_filter_products"
                        android:padding="5dp"
                        android:src="@drawable/ic_search" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="#80E2BFB0" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:padding="4dp"
                        android:src="@drawable/ic_filter" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/homeHeroCard"
                    android:layout_width="match_parent"
                    android:layout_height="450dp"
                    android:layout_marginTop="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/figma_home_hero" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_home_hero_overlay" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:paddingBottom="54dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="23dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="23dp"
                                android:background="@drawable/bg_home_badge_orange"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="@string/home_figma_badge_new"
                                android:textAllCaps="true"
                                android:textColor="@color/aura_white"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="23dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_home_badge_glass"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="@string/home_figma_badge_limited"
                                android:textAllCaps="true"
                                android:textColor="@color/aura_white"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="70dp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="0dp"
                            android:text="@string/home_figma_hero_title"
                            android:textColor="@color/aura_white"
                            android:textSize="30sp" />

                        <TextView
                            android:layout_width="280dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:lineSpacingExtra="1dp"
                            android:text="@string/home_figma_hero_subtitle"
                            android:textColor="#B3FFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/homeHeroCta"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginTop="18dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:text="@string/home_flash_see_more"
                            android:textColor="@color/aura_white"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="146dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="@string/home_figma_categories"
                            android:textColor="#FF111827"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/homeQuickCategories"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:text="@string/home_figma_all"
                            android:textColor="#FFFF7A00"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="106dp"
                        android:layout_marginTop="16dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/homeCategoryStrip"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <include layout="@layout/item_home_category_chip" />
                            <include layout="@layout/item_home_category_chip" />
                            <include layout="@layout/item_home_category_chip" />
                            <include layout="@layout/item_home_category_chip" />
                            <include layout="@layout/item_home_category_chip" />
                            <include layout="@layout/item_home_category_chip" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="310dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="17dp"
                    android:background="@drawable/bg_home_soft_panel"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_home_badge_orange"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/home_flash_sale"
                            android:textColor="@color/aura_white"
                            android:textSize="10sp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/homeQuickBuilder"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:text="@string/home_flash_see_more"
                            android:textColor="@color/aura_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <include
                                layout="@layout/item_aura_product_card"
                                android:layout_width="158dp"
                                android:layout_height="252dp" />

                            <include
                                layout="@layout/item_aura_product_card"
                                android:layout_width="158dp"
                                android:layout_height="252dp" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="17dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/home_video_section"
                            android:textColor="#FF261812"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_home_badge_red"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/home_hot_badge"
                            android:textColor="@color/aura_white"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="176dp"
                        android:layout_marginTop="10dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="150dp"
                                android:layout_height="176dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_home_video_card">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/figma_home_hero" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_home_image_overlay" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:fontFamily="sans-serif-bold"
                                    android:lineSpacingExtra="1dp"
                                    android:padding="12dp"
                                    android:text="@string/home_video_card_one"
                                    android:textColor="@color/aura_white"
                                    android:textSize="11sp" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="150dp"
                                android:layout_height="176dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_home_video_card">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/figma_blog_rtx" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_home_image_overlay" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:fontFamily="sans-serif-bold"
                                    android:lineSpacingExtra="1dp"
                                    android:padding="12dp"
                                    android:text="@string/home_video_card_two"
                                    android:textColor="@color/aura_white"
                                    android:textSize="11sp" />
                            </FrameLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="17dp"
                    android:background="@drawable/bg_home_section_card"
                    android:clipToOutline="true"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="@string/home_daily_section"
                            android:textColor="#FF261812"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="54dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_home_badge_orange"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/home_chip_featured"
                            android:textColor="@color/aura_white"
                            android:textSize="8sp" />

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_subtle"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/home_chip_deals"
                            android:textColor="@color/aura_muted"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="12dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <include
                            layout="@layout/item_aura_product_card"
                            android:layout_width="0dp"
                            android:layout_height="252dp"
                            android:layout_weight="1" />

                        <include
                            layout="@layout/item_aura_product_card"
                            android:layout_width="0dp"
                            android:layout_height="252dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="219dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="17dp"
                    android:background="@drawable/bg_home_section_card"
                    android:clipToOutline="true"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/figma_featured_article" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_home_image_overlay" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:maxLines="2"
                            android:text="@string/home_article_title"
                            android:textColor="@color/aura_white"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/home_article_subtitle"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center_vertical"
                            android:text="@string/home_read_more"
                            android:textColor="@color/aura_white"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="328dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="17dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="@string/home_blog_section"
                            android:textColor="#FF261812"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/homeViewAllProducts"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/home_arrow_next"
                            android:textColor="@color/aura_muted"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="272dp"
                        android:layout_marginTop="16dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <include layout="@layout/item_home_blog_card" />
                            <include layout="@layout/item_home_blog_card_rtx" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/figma_blog_rtx" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66000000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/home_ad_title"
                            android:textColor="@color/aura_white"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_ad_subtitle"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="19dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/home_featured_products"
                    android:textColor="#FF261812"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/productRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="15dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_aura_product_card" />

                <ProgressBar
                    android:id="@+id/loadingProgress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/aura_orange"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <ImageButton
        android:id="@+id/contextualFab"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="84dp"
        android:background="@drawable/bg_chat_fab_orange"
        android:contentDescription="@string/cd_open_chat"
        android:elevation="14dp"
        android:padding="13dp"
        android:src="@drawable/ic_chat" />

    <include
        layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp" />
</FrameLayout>
