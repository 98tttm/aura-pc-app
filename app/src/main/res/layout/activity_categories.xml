<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/categoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_white"
    tools:context="com.aura.pc.ui.categories.CategoriesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/categoryTopAppBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/aura_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/categoryMenuButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_aurapc_logo"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/figma_home_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="@color/aura_white"
                android:textSize="20sp" />

            <FrameLayout
                android:id="@+id/categoryNotificationsButton"
                android:layout_width="34dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_notifications"
                android:focusable="true">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_figma_bell_bold"
                    app:tint="@color/aura_white" />

                <TextView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_home_badge_red"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/home_badge_count"
                    android:textColor="@color/aura_white"
                    android:textSize="6sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/categoryCartButton"
                android:layout_width="34dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/home_open_cart"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_figma_cart_large_bold"
                    app:tint="@color/aura_white" />

                <TextView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_home_badge_red"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/home_badge_count"
                    android:textColor="@color/aura_white"
                    android:textSize="6sp" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/aura_white"
            android:paddingStart="20dp"
            android:paddingTop="19dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@+id/categorySearchBox"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="17dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search_muted" />

                <TextView
                    android:id="@+id/categorySearchText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/home_figma_search_hint"
                    android:textColor="@color/aura_placeholder"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/categoryFilterButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_dark_circle"
                    android:contentDescription="@string/cd_filter_products"
                    android:elevation="7dp"
                    android:padding="8dp"
                    android:src="@drawable/filter"
                    android:translationZ="2dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ScrollView
                android:id="@+id/categorySidebarScroll"
                android:layout_width="88dp"
                android:layout_height="match_parent"
                android:background="@color/aura_soft_orange"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/categorySidebarList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/categoryContentScroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/aura_white"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="118dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/categoryMainTitle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:text="@string/category_laptop"
                            android:textColor="@color/aura_ink"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/categoryViewAllButton"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/home_view_all_chevron"
                            android:textColor="@color/aura_orange"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/categoryProductCount"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="11sp"
                        tools:text="230 sản phẩm" />

                    <TextView
                        style="@style/CategorySectionLabel"
                        android:layout_marginTop="14dp"
                        android:text="@string/category_featured_brands" />

                    <GridLayout
                        android:id="@+id/categoryBrandGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:alignmentMode="alignBounds"
                        android:columnCount="3"
                        android:columnOrderPreserved="false"
                        android:useDefaultMargins="false" />

                    <TextView
                        android:id="@+id/categoryMoreBrandsButton"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_category_more_button"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/category_more_brands"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/CategorySectionLabel"
                        android:layout_marginTop="18dp"
                        android:text="@string/category_price_segment" />

                    <GridLayout
                        android:id="@+id/categoryPriceGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:alignmentMode="alignBounds"
                        android:columnCount="3"
                        android:columnOrderPreserved="false"
                        android:useDefaultMargins="false" />

                    <TextView
                        style="@style/CategorySectionLabel"
                        android:layout_marginTop="18dp"
                        android:text="@string/category_usage_needs" />

                    <GridLayout
                        android:id="@+id/categoryNeedsGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:alignmentMode="alignBounds"
                        android:columnCount="3"
                        android:columnOrderPreserved="false"
                        android:useDefaultMargins="false" />

                    <TextView
                        style="@style/CategorySectionLabel"
                        android:layout_marginTop="18dp"
                        android:text="@string/category_featured_series" />

                    <LinearLayout
                        android:id="@+id/categorySeriesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/CategorySectionLabel"
                        android:layout_marginTop="18dp"
                        android:text="@string/category_chip_line" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="7dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/categoryCpuChipRow"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        style="@style/CategorySectionLabel"
                        android:layout_marginTop="18dp"
                        android:text="@string/category_gpu_line" />

                    <GridLayout
                        android:id="@+id/categoryGpuChipGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:alignmentMode="alignBounds"
                        android:columnCount="2"
                        android:columnOrderPreserved="false"
                        android:useDefaultMargins="false" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/contextualFab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="17dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_chat_fab_orange"
        android:contentDescription="@string/cd_open_chat"
        android:elevation="14dp"
        android:padding="13dp"
        android:src="@drawable/ic_chat"
        app:tint="@color/aura_white" />

    <include
        layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_gravity="bottom" />

    <ProgressBar
        android:id="@+id/categoryLoadingProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/aura_orange"
        android:visibility="gone" />
</FrameLayout>
