<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="34dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_profile_bottom_sheet_handle" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/btnCancelDate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Hủy"
            android:textColor="@color/aura_muted"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Chọn ngày sinh"
            android:textColor="@color/black"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btnDoneDate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Xong"
            android:textColor="@color/premium_nav_active"
            android:textSize="22sp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="-20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="-20dp"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="20dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_date_picker_selected_zone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <NumberPicker
                android:id="@+id/pickerDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:descendantFocusability="blocksDescendants"
                android:theme="@style/AuraDatePickerNumber" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:alpha="0.28"
                android:background="@color/divider" />

            <NumberPicker
                android:id="@+id/pickerMonth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:descendantFocusability="blocksDescendants"
                android:theme="@style/AuraDatePickerNumber" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:alpha="0.28"
                android:background="@color/divider" />

            <NumberPicker
                android:id="@+id/pickerYear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:descendantFocusability="blocksDescendants"
                android:theme="@style/AuraDatePickerNumber" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="34dp"
            android:background="@color/divider" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="34dp"
            android:background="@color/divider" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvManualDateHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:text="Hoặc nhập ngày sinh"
        android:textColor="@color/premium_nav_active"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/edtManualBirthDate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_profile_input_state"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:hint="dd/mm/yyyy"
        android:inputType="phone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary_dark"
        android:textColorHint="@color/premium_nav_inactive"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvManualDateError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/auth_figma_error"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
