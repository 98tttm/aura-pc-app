<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <ProgressBar
        android:id="@+id/progressBarFooter"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/aura_orange"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvErrorFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/aura_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRetryFooter"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/aura_orange"
        android:fontFamily="sans-serif-medium"
        android:text="Thử lại"
        android:textAllCaps="false"
        android:textColor="@color/aura_white"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
