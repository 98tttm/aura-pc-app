<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="139dp"
    android:layout_height="169dp"
    android:layout_marginEnd="0dp"
    android:background="@drawable/bg_home_sale_card"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="7dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:contentDescription="@string/home_product_cpu_name"
        android:scaleType="fitCenter"
        android:src="@drawable/figma_sale_cpu" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-bold"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/home_product_cpu_name"
        android:textColor="@color/aura_ink"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/home_product_cpu_price"
            android:textColor="@color/aura_orange"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/home_product_cpu_old_price"
            android:textColor="#FFB7B7B7"
            android:textSize="8sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="4dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_home_stock_track" />

        <View
            android:layout_width="19dp"
            android:layout_height="12dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_home_stock_fill" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/home_flash_stock"
            android:textColor="@color/aura_white"
            android:textSize="7.5sp" />
    </FrameLayout>
</LinearLayout>
