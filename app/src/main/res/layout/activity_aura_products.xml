<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/aura_orange"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_aurapc_logo"
                android:padding="2dp"
                android:src="@drawable/figma_home_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="@color/aura_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp">

                <ImageButton
                    android:id="@+id/topNotificationsButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_notifications"
                    android:padding="7dp"
                    android:src="@drawable/ic_figma_bell_bold"
                    app:tint="@color/aura_white" />

                <TextView
                    android:id="@+id/header_notification_badge"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_header_badge_red"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/home_badge_count"
                    android:textColor="@color/aura_white"
                    android:textSize="6sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp">

                <ImageButton
                    android:id="@+id/topCartButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_open_cart"
                    android:padding="7dp"
                    android:src="@drawable/ic_figma_cart_large_bold"
                    app:tint="@color/aura_white" />

                <TextView
                    android:id="@+id/header_cart_badge"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_header_badge_red"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/aura_white"
                    android:textSize="6sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingBottom="146dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_search_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="17dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search_muted" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/search_hint"
                        android:includeFontPadding="false"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="@color/aura_ink"
                        android:textColorHint="@color/aura_placeholder"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/searchFilterButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_dark_circle"
                        android:contentDescription="@string/cd_filter_products"
                        android:elevation="7dp"
                        android:padding="10dp"
                        android:src="@drawable/filter"
                        android:translationZ="2dp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="16dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/AuraChip"
                            android:background="@drawable/bg_chip_active"
                            android:text="@string/filter_all"
                            android:textColor="@color/aura_white" />

                        <TextView
                            style="@style/AuraChip"
                            android:layout_marginStart="16dp"
                            android:text="@string/filter_best_seller" />

                        <TextView
                            style="@style/AuraChip"
                            android:layout_marginStart="16dp"
                            android:text="@string/filter_good_price" />

                        <TextView
                            style="@style/AuraChip"
                            android:layout_marginStart="16dp"
                            android:text="@string/filter_gaming" />

                        <TextView
                            style="@style/AuraChip"
                            android:layout_marginStart="16dp"
                            android:background="@drawable/bg_chip_subtle"
                            android:text="@string/filter_office" />
                    </LinearLayout>
                </HorizontalScrollView>

                <GridLayout
                    android:id="@+id/productGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:alignmentMode="alignBounds"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:columnCount="2"
                    android:columnOrderPreserved="false"
                    android:gravity="center_horizontal"
                    android:rowCount="4"
                    android:useDefaultMargins="false">

                    <FrameLayout style="@style/AuraProductGridItemLeft">
                        <include layout="@layout/item_product_list_card" />
                    </FrameLayout>

                    <FrameLayout style="@style/AuraProductGridItemRight">
                        <include layout="@layout/item_product_list_card" />
                    </FrameLayout>

                    <FrameLayout style="@style/AuraProductGridItemLeft">
                        <include layout="@layout/item_product_list_card" />
                    </FrameLayout>

                    <FrameLayout style="@style/AuraProductGridItemRight">
                        <include layout="@layout/item_product_list_card" />
                    </FrameLayout>

                    <FrameLayout style="@style/AuraProductGridItemLeft">
                        <include layout="@layout/item_product_list_card" />
                    </FrameLayout>

                    <FrameLayout style="@style/AuraProductGridItemRight">
                        <include layout="@layout/item_product_list_card" />
                    </FrameLayout>

                    <FrameLayout style="@style/AuraProductGridItemLeft">
                        <include layout="@layout/item_product_list_card" />
                    </FrameLayout>

                    <FrameLayout style="@style/AuraProductGridItemRight">
                        <include layout="@layout/item_product_list_card" />
                    </FrameLayout>
                </GridLayout>

                <Button
                    android:id="@+id/loadMoreProductsButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="11dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/bg_product_load_more_button"
                    android:backgroundTint="@null"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/product_list_load_more_initial"
                    android:textAllCaps="false"
                    android:textColor="@color/aura_white"
                    android:textSize="20sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <ImageButton
        android:id="@+id/contextualFab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="128dp"
        android:background="@drawable/bg_dark_circle"
        android:contentDescription="@string/cd_open_filters"
        android:elevation="14dp"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp"
        android:src="@drawable/filter"
        android:translationZ="3dp" />

    <include
        layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp" />
</FrameLayout>
