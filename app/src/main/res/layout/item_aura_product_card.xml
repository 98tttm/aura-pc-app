<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="310dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_home_product_card_figma"
    android:clipToOutline="true"
    android:elevation="2dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:background="@color/aura_white">

        <ImageView
            android:id="@+id/productImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_product_image_acer_nitro_v16s"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/figma_sale_case" />

        <TextView
            android:id="@+id/productSaleBadge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_badge_red"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="46dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/home_product_trend_badge"
            android:textColor="@color/aura_white"
            android:textSize="10sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/productTitle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="@string/home_product_case_name"
            android:textColor="@color/aura_ink"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/productSpecRow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/productSpecOneText"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:background="@drawable/bg_chip_default"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/aura_muted"
                android:textSize="9sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/productSpecTwoText"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_chip_default"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/aura_muted"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/productPriceText"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/home_product_case_price"
            android:textColor="@color/aura_orange"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/oldPriceText"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/home_product_case_old_price"
            android:textColor="#FFB7B7B7"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star" />

            <TextView
                android:id="@+id/productRatingText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/home_product_rating_short"
                android:textColor="@color/aura_muted"
                android:textSize="10sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/productBuyButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_dark_circle"
                android:contentDescription="@string/cd_add_to_cart"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cart_add"
                app:tint="@color/aura_white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
