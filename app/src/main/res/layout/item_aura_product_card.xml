<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="252dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_home_section_card"
    android:clipToOutline="true"
    android:elevation="2dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_home_soft_panel">

        <ImageView
            android:id="@+id/productImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_product_image_acer_nitro_v16s"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/figma_product_monitor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_badge_red"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="34dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:text="@string/home_hot_badge"
            android:textColor="@color/aura_white"
            android:textSize="9sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/productTitle"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="@string/home_product_monitor"
            android:textColor="@color/aura_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/productPriceText"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/home_product_monitor_price"
            android:textColor="@color/aura_orange"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/oldPriceText"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star" />

            <TextView
                android:id="@+id/productRatingText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/home_product_rating_one"
                android:textColor="@color/aura_muted"
                android:textSize="9sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/productBuyButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_chat_fab_orange"
                android:contentDescription="@string/cd_add_to_cart"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_cart_plus"
                app:tint="@color/aura_white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
