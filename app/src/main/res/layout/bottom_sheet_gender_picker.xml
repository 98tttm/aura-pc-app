<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="34dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_profile_bottom_sheet_handle" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/btnCancelGender"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Hủy"
            android:textColor="@color/aura_muted"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Chọn giới tính"
            android:textColor="@color/black"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btnDoneGender"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Xong"
            android:textColor="@color/premium_nav_active"
            android:textSize="18sp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="-20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="-20dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/optionMale"
        style="@style/AuraGenderPickerRow"
        android:layout_marginTop="28dp">

        <TextView
            android:id="@+id/labelMale"
            style="@style/AuraGenderPickerLabel"
            android:text="Nam" />

        <ImageView
            android:id="@+id/checkMale"
            style="@style/AuraGenderPickerCheck"
            android:src="@drawable/ic_gender_check" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionFemale"
        style="@style/AuraGenderPickerRow">

        <TextView
            android:id="@+id/labelFemale"
            style="@style/AuraGenderPickerLabel"
            android:text="Nữ" />

        <ImageView
            android:id="@+id/checkFemale"
            style="@style/AuraGenderPickerCheck"
            android:src="@drawable/ic_gender_check" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionOther"
        style="@style/AuraGenderPickerRow">

        <TextView
            android:id="@+id/labelOther"
            style="@style/AuraGenderPickerLabel"
            android:text="Khác" />

        <ImageView
            android:id="@+id/checkOther"
            style="@style/AuraGenderPickerCheck"
            android:src="@drawable/ic_gender_check" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionPreferNotToSay"
        style="@style/AuraGenderPickerRow">

        <TextView
            android:id="@+id/labelPreferNotToSay"
            style="@style/AuraGenderPickerLabel"
            android:text="Không muốn trả lời" />

        <ImageView
            android:id="@+id/checkPreferNotToSay"
            style="@style/AuraGenderPickerCheck"
            android:src="@drawable/ic_gender_check" />
    </LinearLayout>
</LinearLayout>
