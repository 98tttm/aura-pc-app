<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_payment_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_payment_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_default_badge"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_payment_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_credit_card" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_payment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Thẻ tín dụng / Ghi nợ"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_payment_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="**** **** **** 4090"
            android:textColor="@color/checkout_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_radio"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_radio_unselected" />

</LinearLayout>