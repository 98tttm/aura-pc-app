<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/bg_home_product_card_figma"
    android:clipToOutline="true"
    android:elevation="2dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:background="@color/aura_white">

        <ImageView
            android:id="@+id/productImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_product_image_acer_nitro_v16s"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/figma_sale_case" />

        <TextView
            android:id="@+id/productSaleBadge"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="7dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_home_badge_red"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="44dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/home_product_trend_badge"
            android:textColor="@color/aura_white"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="7dp"
        android:paddingEnd="9dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/productTitle"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="@string/home_product_case_name"
            android:textColor="@color/aura_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/productPriceText"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/home_product_case_price"
            android:textColor="@color/aura_orange"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/oldPriceText"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/home_product_case_old_price"
            android:textColor="#FFB7B7B7"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star" />

            <TextView
                android:id="@+id/productRatingText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/home_product_rating_short"
                android:textColor="@color/aura_muted"
                android:textSize="9sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/productBuyButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_dark_circle"
                android:contentDescription="@string/cd_add_to_cart"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cart_add"
                app:tint="@color/aura_white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
