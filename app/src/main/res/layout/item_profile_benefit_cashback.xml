<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ProfileBenefitRow"
    android:layout_marginBottom="0dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_payments"
        app:tint="#FFA04100" />

    <LinearLayout style="@style/ProfileBenefitTextGroup">
        <TextView
            style="@style/ProfileBenefitTitle"
            android:text="@string/profile_benefit_cashback_title" />
        <TextView
            style="@style/ProfileBenefitDesc"
            android:text="@string/profile_benefit_cashback_desc" />
    </LinearLayout>
</LinearLayout>
