<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavCard"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="302dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_bottom_nav_figma"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <FrameLayout
            android:id="@+id/nav_home_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="13dp"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_figma_nav_home"
                app:tint="@color/premium_nav_inactive" />

            <View
                android:id="@+id/nav_home_indicator"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="9dp"
                android:background="@drawable/bg_nav_active_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_categories_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_categories_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_categories"
                android:src="@drawable/ic_figma_nav_categories"
                app:tint="@color/premium_nav_inactive" />

            <View
                android:id="@+id/nav_categories_indicator"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="9dp"
                android:background="@drawable/bg_nav_active_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_cart_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_cart_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_cart"
                android:src="@drawable/ic_figma_nav_cart"
                app:tint="@color/premium_nav_inactive" />

            <View
                android:id="@+id/nav_cart_indicator"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="9dp"
                android:background="@drawable/bg_nav_active_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_blog_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_blog_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_blog"
                android:src="@drawable/ic_figma_nav_blog"
                app:tint="@color/premium_nav_inactive" />

            <View
                android:id="@+id/nav_blog_indicator"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="9dp"
                android:background="@drawable/bg_nav_active_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_profile_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_profile_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_profile"
                android:src="@drawable/ic_figma_nav_user"
                app:tint="@color/premium_nav_inactive" />

            <View
                android:id="@+id/nav_profile_indicator"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="9dp"
                android:background="@drawable/bg_nav_active_dot"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
