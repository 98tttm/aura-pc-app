<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/profileHeader"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/premium_nav_active"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/btnBackProfile"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:contentDescription="@null"
                android:paddingVertical="23dp"
                android:src="@drawable/ic_profile_back_white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:layout_toEndOf="@id/btnBackProfile"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="53dp"
                    android:layout_height="38dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/aura_logo_mark_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="AuraPC"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
            </LinearLayout>
        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollProfile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="36dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="38dp"
                android:paddingBottom="52dp">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/aura_logo_mark" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="Hoàn tất hồ sơ"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="26dp"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="Vui lòng nhập một vài thông tin cơ bản để bắt đầu sử dụng AuraPC."
                    android:textColor="@color/aura_nav_muted"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/formCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp"
                    android:background="@drawable/bg_profile_card"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="38dp">

                    <TextView
                        android:id="@+id/errorBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_profile_error_banner"
                        android:padding="14dp"
                        android:text="Không thể lưu hồ sơ. Vui lòng thử lại."
                        android:textColor="#D9432F"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="HỌ VÀ TÊN *"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtFullName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:hint="Nhập họ và tên"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/premium_nav_inactive"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/errorFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#D9432F"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="EMAIL"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:hint="Nhập email"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/premium_nav_inactive"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/errorEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#D9432F"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="SỐ ĐIỆN THOẠI"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:hint="0901 234 567"
                        android:inputType="phone"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/premium_nav_inactive"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/errorPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#D9432F"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="NGÀY SINH"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDateOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_profile_calendar"
                        android:drawablePadding="12dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp"
                        android:text="Chọn ngày sinh"
                        android:textColor="@color/premium_nav_inactive"
                        android:textSize="16sp"
                        app:drawableTint="@color/premium_nav_inactive" />

                    <TextView
                        android:id="@+id/errorDateOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#D9432F"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="GIỚI TÍNH"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvGender"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_profile_chevron_down"
                        android:drawablePadding="12dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp"
                        android:text="Chọn giới tính"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="16sp"
                        app:drawableTint="@color/aura_nav_muted" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="ĐỊA CHỈ"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtAddress"
                        android:layout_width="match_parent"
                        android:layout_height="132dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:gravity="top|start"
                        android:hint="Số nhà, tên đường, phường/xã..."
                        android:inputType="text|textPostalAddress|textMultiLine|textCapSentences"
                        android:minLines="3"
                        android:paddingStart="16dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/premium_nav_inactive"
                        android:textSize="16sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginTop="40dp"
                        android:background="@drawable/bg_profile_submit_orange">

                        <ProgressBar
                            android:id="@+id/progressSubmit"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="78dp"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btnSubmitProfile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:text="Hoàn tất"
                            android:textColor="@color/white"
                            android:textSize="20sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="Bằng cách tiếp tục, bạn đồng ý với Điều khoản &amp; Chính sách của chúng tôi."
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="76dp"
            android:contentDescription="@null"
            android:src="@drawable/aura_logo_mark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Hoàn tất thành công"
            android:textColor="@color/text_primary_dark"
            android:textSize="25sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Hồ sơ của bạn đã được lưu."
            android:textColor="@color/aura_nav_muted"
            android:textSize="15sp" />

        <ProgressBar
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/premium_nav_active" />
    </LinearLayout>
</FrameLayout>
