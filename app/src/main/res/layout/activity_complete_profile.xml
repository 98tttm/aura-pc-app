<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/profileHeader"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/premium_nav_active"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/btnBackProfile"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:contentDescription="@null"
                android:paddingVertical="23dp"
                android:src="@drawable/ic_profile_back_white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:layout_toEndOf="@id/btnBackProfile"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="53dp"
                    android:layout_height="38dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/aura_logo_mark_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="AuraPC"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
            </LinearLayout>
        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollProfile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="36dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="30dp"
                android:paddingBottom="52dp">

                <FrameLayout
                    android:id="@+id/editProfileAvatarFrame"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_profile_avatar"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/editProfileAvatarImage"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_profile_avatar"
                        android:clipToOutline="true"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/editProfileAvatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/profile_default_initial"
                        android:textColor="@color/aura_orange"
                        android:textSize="34sp" />

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_profile_avatar_action">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="+"
                            android:textColor="@color/aura_white"
                            android:textSize="18sp" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/editProfileAvatarChangeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/profile_edit_avatar_change"
                    android:textColor="@color/premium_nav_active"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/profileEditTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/profile_edit_title"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/profileEditSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="26dp"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/profile_edit_subtitle"
                    android:textColor="@color/aura_nav_muted"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/formCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_profile_card"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="34dp">

                    <TextView
                        android:id="@+id/errorBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_profile_error_banner"
                        android:padding="14dp"
                        android:text="@string/profile_edit_save_error"
                        android:textColor="#D9432F"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/profile_edit_field_full_name"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtFullName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:hint="@string/profile_edit_hint_full_name"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/premium_nav_inactive"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/errorFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#D9432F"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/profile_edit_field_email"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:hint="@string/profile_edit_hint_email"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/premium_nav_inactive"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/errorEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#D9432F"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/profile_edit_field_phone"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:hint="@string/profile_edit_hint_phone"
                        android:inputType="phone"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary_dark"
                        android:textColorHint="@color/premium_nav_inactive"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/errorPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#D9432F"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/profile_edit_field_birth_date"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDateOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_profile_calendar"
                        android:drawablePadding="12dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp"
                        android:text="@string/profile_edit_hint_birth_date"
                        android:textColor="@color/premium_nav_inactive"
                        android:textSize="16sp"
                        app:drawableTint="@color/premium_nav_inactive" />

                    <TextView
                        android:id="@+id/errorDateOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#D9432F"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/profile_edit_field_gender"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvGender"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_profile_input_state"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_profile_chevron_down"
                        android:drawablePadding="12dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp"
                        android:text="@string/profile_edit_hint_gender"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="16sp"
                        app:drawableTint="@color/aura_nav_muted" />

                    <FrameLayout
                        android:layout_width="260dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="36dp"
                        android:background="@drawable/bg_profile_submit_orange">

                        <ProgressBar
                            android:id="@+id/progressSubmit"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="42dp"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btnSubmitProfile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:text="@string/profile_edit_save_changes"
                            android:textColor="@color/white"
                            android:textSize="16sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/profile_edit_terms"
                        android:textColor="@color/aura_nav_muted"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="76dp"
            android:contentDescription="@null"
            android:src="@drawable/aura_logo_mark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/profile_edit_save_success_title"
            android:textColor="@color/text_primary_dark"
            android:textSize="25sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/profile_edit_save_success_subtitle"
            android:textColor="@color/aura_nav_muted"
            android:textSize="15sp" />

        <ProgressBar
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/premium_nav_active" />
    </LinearLayout>
</FrameLayout>
