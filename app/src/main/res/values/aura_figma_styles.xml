<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AuraChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_chip_default</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textColor">@color/aura_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AuraProductGridItemLeft">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">362dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">27dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="AuraProductGridItemRight">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">362dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginBottom">27dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="AuraBottomNavItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="AuraBottomNavIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="AuraBottomNavText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/aura_nav_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CategorySectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/aura_nav_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.AuraPC.CheckoutButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_checkout_button</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">32dp</item>
        <item name="elevation">12dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="HomeQuickActionCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">118dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="cardBackgroundColor">@color/aura_white</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/aura_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="HomeQuickActionContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="HomeQuickActionIcon">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/bg_category_icon_soft</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:padding">9dp</item>
        <item name="tint">@color/aura_orange</item>
    </style>

    <style name="HomeQuickActionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/aura_ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="HomeQuickActionSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/aura_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
