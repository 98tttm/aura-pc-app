<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Splash (login screen uses this until login completes) -->
    <style name="Theme.AuraPCAdmin.Splash" parent="Theme.AuraPCAdmin">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Main app theme -->
    <style name="Theme.AuraPCAdmin" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/aura_orange</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/aura_orange_soft</item>
        <item name="colorOnPrimaryContainer">@color/aura_orange</item>

        <item name="colorSecondary">@color/status_info</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="colorTertiary">@color/status_vip</item>
        <item name="colorOnTertiary">@color/black</item>

        <item name="android:colorBackground">@color/bg_canvas</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/bg_surface_elevated</item>
        <item name="colorOutline">@color/border_default</item>
        <item name="colorOutlineVariant">@color/border_subtle</item>

        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="materialButtonStyle">@style/Widget.Aura.Button</item>
        <item name="materialAlertDialogTheme">@style/Theme.AuraPCAdmin.Dialog</item>
    </style>

    <style name="Widget.Aura.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/aura_orange</item>
        <item name="android:textColor">@color/black</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Aura.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border_default</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/aura_orange_soft</item>
    </style>

    <style name="Widget.Aura.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.Aura.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="boxStrokeColor">@color/aura_orange</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <style name="TextAppearance.Aura.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Aura.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Aura.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="Theme.AuraPCAdmin.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>
</resources>