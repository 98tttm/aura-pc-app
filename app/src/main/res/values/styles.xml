<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FigmaOtpDigit">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_otp_figma_box</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/auth_figma_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AuraDatePickerNumber">
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColorPrimary">@color/premium_nav_active</item>
        <item name="android:textColorSecondary">@color/premium_nav_inactive</item>
        <item name="android:colorAccent">@color/premium_nav_active</item>
    </style>

    <style name="AuraGenderPickerRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/bg_gender_option_transparent</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AuraGenderPickerLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="AuraGenderPickerCheck">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
