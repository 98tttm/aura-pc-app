<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ProfileQuickActionItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ProfileQuickActionIconFrame">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_profile_soft_icon</item>
    </style>

    <style name="ProfileQuickActionIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/aura_orange</item>
    </style>

    <style name="ProfileQuickActionText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/aura_nav_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ProfileMenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">39dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawableEnd">@drawable/ic_arrow_forward_rounded</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/aura_ink</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ProfileProductCard">
        <item name="android:layout_width">280dp</item>
        <item name="android:layout_height">318dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:background">@drawable/bg_profile_product_card</item>
        <item name="android:elevation">2dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">1dp</item>
    </style>

    <style name="ProfileSuggestionTag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">19dp</item>
        <item name="android:background">@drawable/bg_chip_subtle</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">#FF474746</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="ProfileBenefitRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="ProfileBenefitTextGroup">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ProfileBenefitTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/aura_ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ProfileBenefitDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">@color/aura_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FigmaOtpDigit">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_otp_figma_box</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/auth_figma_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
